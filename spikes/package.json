{
  "name": "keeb-cad-spikes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "build": "vite build",
    "route": "playwright test",
    "verify": "pnpm install --frozen-lockfile && playwright install chromium && pnpm typecheck && pnpm test && pnpm build && pnpm route && pnpm kicad-drc",
    "test": "vitest run",
    "kicad-drc": "node --import ./scripts/ts-resolve.mjs scripts/kicad-drc.ts"
  },
  "dependencies": {
    "@tscircuit/capacity-autorouter": "0.0.1010",
    "clipper2-ts": "2.0.1-18",
    "flatbush": "4.6.2",
    "makerjs": "0.19.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
