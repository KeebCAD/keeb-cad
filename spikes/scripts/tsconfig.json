{
  // Node-side code: the kicad-drc and score:tscircuit scripts, their helpers and tests, and the Vite, Vitest and Playwright
  // configs (vite's types pull in node). src/vite-env.d.ts types the `?raw` imports of src/corney.ts,
  // which scripts/ts-resolve.mjs loads. The one project with @types/node; src/ has none.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["*.ts", "../src/vite-env.d.ts", "../vite.config.ts", "../vitest.config.ts", "../playwright.config.ts"]
}
