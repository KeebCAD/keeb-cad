{
  "name": "keeb-cad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "depcruise": "depcruise packages app/src reference-designs --config .dependency-cruiser.mts",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "build": "pnpm --filter @keeb-cad/app build",
    "build:workbench": "pnpm --filter @keeb-cad/ui build:workbench",
    "smoke": "pnpm --filter @keeb-cad/app test:e2e",
    "check:fast": "pnpm lint && pnpm format:check && pnpm depcruise",
    "check": "pnpm typecheck && pnpm check:fast && pnpm test && pnpm build && pnpm build:workbench && pnpm smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "catalog:"
  }
}
