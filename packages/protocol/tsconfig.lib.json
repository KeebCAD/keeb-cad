{
  // The model worker's messages. No DOM lib: both main and the model worker read them.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    // WebWorker because this program type-checks messaging's source, which posts messages.
    "lib": ["ES2023", "WebWorker"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
