{
  // Every command and action. No DOM lib: entries run on main through the design store.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    // Symbol.dispose and Symbol.asyncDispose, which di's container calls on dispose().
    // WebWorker because this program type-checks design's store source, which calls structuredClone,
    // and storage's browser backend, which reads indexedDB.
    "lib": ["ES2023", "ESNext.Disposable", "WebWorker"],
    // vite/client types import.meta.glob, which design's store reaches through library's declarations.
    "types": ["vite/client"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
