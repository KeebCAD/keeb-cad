// TSConfig for the spec that checks the committed parser against its grammar, which runs in Node.js.
{
  "extends": "@tsconfig/node26/tsconfig.json",
  "include": ["generated-parser/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
