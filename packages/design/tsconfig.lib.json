{
  // The design store and the patcher. No DOM lib: design/worker runs in the model worker.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    // Symbol.dispose and Symbol.asyncDispose, which di's container calls on dispose().
    // WebWorker for structuredClone, which the store copies run's input with. Worker-only globals
    // (importScripts, self as WorkerGlobalScope) also type-check here but don't exist on main.
    "lib": ["ES2023", "ESNext.Disposable", "WebWorker"],
    // vite/client types import.meta.glob, which the store reaches through library's declarations.
    "types": ["vite/client"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
