{
  // The container and its Vue bridge. No DOM lib: di's root runs on every thread (AD-25).
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    // Symbol.dispose and Symbol.asyncDispose, which the container calls on dispose().
    "lib": ["ES2023", "ESNext.Disposable"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  }
}
