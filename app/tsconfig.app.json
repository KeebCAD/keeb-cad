{
  // The shared base comes second so its strictness applies; DOM `lib`/`types` are restored below.
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "../tsconfig.base.json"],
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    // Restore what tsconfig.base.json overrides from @vue/tsconfig/tsconfig.dom.json.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
